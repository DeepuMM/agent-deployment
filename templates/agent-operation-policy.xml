<!-- AI gateway policy for one agent's operations (GET, POST, DELETE /<agent>/*): only this agent's values. The logic is
     in shared policy fragments (ai-gateway repository, gateway/policy-fragments/, deployed once per APIM by
     gateway-policy-deployment), so changing it needs no agent redeploy. Placeholders __AGENT__, __KIND__, __RATE__ and
     __QUOTA__ are filled by scripts/agent_pipeline.py; {{...}} are APIM named values created by the same script.
     The gateway is transparent: callers send the request they would send to Foundry (agent-route has the paths). -->
<policies>
  <inbound>
    <set-variable name="agent" value="__AGENT__" />
    <set-variable name="agent-kind" value="__KIND__" />
    <set-variable name="agent-status" value="{{ks-agent-__AGENT__}}" />
    <set-variable name="agent-name" value="{{agent-name-__AGENT__}}" />
    <set-variable name="agent-version" value="{{agent-version-__AGENT__}}" />
    <set-variable name="agent-rate" value="@(__RATE__)" />
    <!-- The caller's Entra token (same one it would send to Foundry): validated, caller identity kept. -->
    <include-fragment fragment-id="agent-caller" />
    <!-- Kill switch, agent rate limit per consumer. -->
    <include-fragment fragment-id="agent-guardrails" />
    <!-- Agent daily quota per consumer: here, not in the fragment (quota-by-key takes no expression in calls). -->
    <quota-by-key calls="__QUOTA__" renewal-period="86400"
        counter-key="@((context.Subscription?.Id ?? context.Request.IpAddress) + &quot;|__AGENT__&quot;)" />
    <!-- Project policy: project limits, correlation ID, managed identity to Foundry. -->
    <base />
    <!-- Route to the agent's Foundry endpoint at its evaluated version; caller identity for hosted agents. -->
    <include-fragment fragment-id="agent-route" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
