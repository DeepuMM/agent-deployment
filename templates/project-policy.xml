<!-- AI gateway policy for a Foundry project API (all agents): only this project's values. The logic is in shared
     policy fragments (gateway/policy-fragments/, deployed once per APIM by gateway-policy-deployment). Placeholders
     __RATE__ and __QUOTA__ are filled by scripts/agent_pipeline.py. Agent-specific rules are operation policies. -->
<policies>
  <inbound>
    <base />
    <set-variable name="project-rate" value="@(__RATE__)" />
    <!-- Project daily quota per consumer: here, not in the fragment (quota-by-key takes no expression in calls). -->
    <quota-by-key calls="__QUOTA__" renewal-period="86400"
        counter-key="@((context.Subscription?.Id ?? context.Request.IpAddress) + &quot;|project&quot;)" />
    <!-- Project rate limit, correlation ID, forward to the Responses API, managed identity. -->
    <include-fragment fragment-id="project-inbound" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <include-fragment fragment-id="project-outbound" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
