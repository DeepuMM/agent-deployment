<!-- AI gateway policy for a Foundry prompt agent. Placeholders __AGENT__, __RATE__ and __QUOTA__ are filled
     by scripts/register_apim.py; {{...}} are APIM named values created by the same script. -->
<policies>
  <inbound>
    <base />
    <!-- Kill switch: anything other than "active" blocks the agent (fails closed). -->
    <choose>
      <when condition="@(!string.Equals(&quot;{{ks-agent-__AGENT__}}&quot;, &quot;active&quot;, StringComparison.OrdinalIgnoreCase))">
        <return-response>
          <set-status code="503" reason="Service Unavailable" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="Retry-After" exists-action="override"><value>300</value></set-header>
          <set-body>@{
            return new JObject(
              new JProperty("error", new JObject(
                new JProperty("code", "AI_ROUTE_SUSPENDED"),
                new JProperty("message", "This agent is suspended by the platform kill switch."),
                new JProperty("correlationId", context.RequestId.ToString())))).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
    <!-- Throttling per consumer (subscription, or caller IP if no subscription is used). -->
    <rate-limit-by-key calls="__RATE__" renewal-period="60"
        counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)"
        remaining-calls-header-name="x-ratelimit-remaining" retry-after-header-name="Retry-After" />
    <quota-by-key calls="__QUOTA__" renewal-period="86400"
        counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />
    <set-header name="x-correlation-id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <!-- Foundry Responses API with the agent fixed by the gateway; callers cannot choose another agent or model. -->
    <rewrite-uri template="/openai/v1/responses" copy-unmatched-params="false" />
    <set-body>@{
      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true) ?? new JObject();
      body.Remove("model");
      body["agent_reference"] = new JObject(
        new JProperty("type", "agent_reference"),
        new JProperty("name", "{{agent-name-__AGENT__}}"));
      return body.ToString();
    }</set-body>
    <!-- APIM, not the caller, authenticates to Foundry; the caller's key is not passed on. -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <authentication-managed-identity resource="https://ai.azure.com" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
