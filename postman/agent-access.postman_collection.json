{
  "info": {
    "_postman_id": "d11b5c92-0815-561f-8592-2402d0d97119",
    "name": "AI gateway: agent access",
    "description": "Calling agents through the AI gateway with each access list (one token, in Authorization) (agent.yaml `access`), the refusals, and an agent calling another agent. Tokens: postman/get_tokens.sh (writes postman/local.postman_environment.json). Access for the demo: postman/grant_demo_access.sh. Details: postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every request: log the agent's answer (Responses API output messages) and keep it in last_answer.",
          "try {",
          "  const j = pm.response.json();",
          "  const text = (j.output || []).filter(o => o.type === 'message').flatMap(o => o.content || []).map(c => c.text || '').join(' ');",
          "  if (text) { console.log(pm.info.requestName + ' \u2192 ' + text); pm.variables.set('last_answer', text); }",
          "  if (j.error) { console.log(pm.info.requestName + ' \u2192 ' + JSON.stringify(j.error)); }",
          "} catch (e) {}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "conversation_id",
      "value": ""
    },
    {
      "key": "basic_code_agent_oid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 [gateway] basic-code-agent (hosted): agent app role",
      "description": "access: [gateway]. Authorization: a token for the gateway's agent app; your identity needs role agent.models-demo.basic-code-agent (or agent.models-demo.all). Foundry sees the gateway; the gateway passes your object ID, so conversations stay yours.",
      "item": [
        {
          "name": "Ask",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agent_app_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/ai/models-demo/basic-code-agent/endpoint/protocols/openai/responses?api-version=v1",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"What is the capital of France? Answer in one word.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('answer mentions Paris', () => pm.expect((pm.variables.get('last_answer') || '').toLowerCase()).to.include('paris'));"
                ]
