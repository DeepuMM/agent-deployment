    {
      "name": "5 \u00b7 Agent to agent: basic-code-agent \u2192 leave-policy-agent",
      "description": "basic-code-agent (hosted) asks leave-policy-agent (prompt, proj-default) through the gateway with its own identity (tool ask_agent). Run 5.1, then 5.2: refused until that identity holds role agent.proj-default.leave-policy-agent (grant_demo_access.sh <oid from 5.1>); run 5.2 again: the answer comes from leave-policy-agent.",
      "item": [
        {
          "name": "5.1 Which identity does basic-code-agent call with?",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agent_app_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/ai/models-demo/basic-code-agent/endpoint/protocols/openai/responses?api-version=v1",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"Use the gateway_identity tool and reply with its JSON only.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const m = (pm.variables.get('last_answer') || '').match(/\"oid\"\\s*:\\s*\"([0-9a-f-]{36})\"/);",
                  "pm.test('object ID found', () => pm.expect(m).to.not.be.null);",
                  "if (m) { pm.collectionVariables.set('basic_code_agent_oid', m[1]); console.log('grant to: ./postman/grant_demo_access.sh ' + m[1]); }"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Ask a leave question through basic-code-agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agent_app_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/ai/models-demo/basic-code-agent/endpoint/protocols/openai/responses?api-version=v1",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"How many days of annual leave do I get each year?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
