          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const a = (pm.variables.get('last_answer') || '');",
                  "pm.test('answer from leave-policy-agent (18 days) \u2014 refused until the role is granted', () => pm.expect(a).to.include('18'));"
                ]
              }
            }
          ]
        }
