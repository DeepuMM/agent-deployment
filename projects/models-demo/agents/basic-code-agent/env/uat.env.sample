# SAMPLE for uat: rename to uat.env once models-demo lists uat in project.yaml environments (a .env file for an
# environment the project doesn't deploy to fails ci). Non-secret settings only, KEY=VALUE; they apply to the uat
# version only, on top of agent.yaml environment. The platform sets PLATFORM_ENVIRONMENT, PLATFORM_PROJECT,
# AI_GATEWAY_URL, AI_GATEWAY_PROJECT_URL and AZURE_AI_MODEL_DEPLOYMENT_NAME itself; they can't be set here.
LOG_LEVEL=INFO
