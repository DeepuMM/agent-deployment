# basic-code-agent settings for dev only (non-secret, KEY=VALUE). agent-deploy adds them to the dev version's
# environment variables, on top of agent.yaml `environment`; the platform's own variables (PLATFORM_ENVIRONMENT,
# AI_GATEWAY_URL, ...) are set by the pipeline and can't be overridden here. Secrets: Key Vault, never here.
LOG_LEVEL=INFO
# Agents this agent may ask through the gateway (tool ask_agent), <project>/<agent>, comma-separated. The gateway
# still requires the called agent's role for this agent's identity (granted outside the pipelines).
CALLABLE_AGENTS=proj-default/leave-policy-agent
