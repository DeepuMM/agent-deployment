<fragment>
  <!-- Shared by every agent operation, BEFORE <base />. Deployed by gateway-policy-deployment (one copy per APIM).
       Reads the context variables set by templates/agent-operation-policy.xml:
         agent          agent name (counter keys)
         agent-status   value of named value ks-agent-<agent>
         agent-rate     calls per minute per consumer (int)
         agent-quota    calls per day per consumer (int) -->

  <!-- Kill switch: anything other than "active" blocks this agent (fails closed, also when the variable is missing). -->
  <choose>
    <when condition="@(!string.Equals(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;agent-status&quot;, &quot;&quot;), &quot;active&quot;, StringComparison.OrdinalIgnoreCase))">
      <return-response>
        <set-status code="503" reason="Service Unavailable" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Retry-After" exists-action="override"><value>300</value></set-header>
        <set-body>@{
          return new JObject(
            new JProperty("error", new JObject(
              new JProperty("code", "AI_ROUTE_SUSPENDED"),
              new JProperty("message", "This agent is suspended by the platform kill switch."),
              new JProperty("correlationId", context.RequestId.ToString())))).ToString();
        }</set-body>
      </return-response>
    </when>
  </choose>

  <!-- Agent limits per consumer. -->
  <rate-limit-by-key calls="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;agent-rate&quot;, 0))" renewal-period="60"
      counter-key="@((context.Subscription?.Id ?? context.Request.IpAddress) + &quot;|&quot; + context.Variables.GetValueOrDefault&lt;string&gt;(&quot;agent&quot;, &quot;&quot;))"
      remaining-calls-header-name="x-ratelimit-remaining" retry-after-header-name="Retry-After" />
  <quota-by-key calls="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;agent-quota&quot;, 0))" renewal-period="86400"
      counter-key="@((context.Subscription?.Id ?? context.Request.IpAddress) + &quot;|&quot; + context.Variables.GetValueOrDefault&lt;string&gt;(&quot;agent&quot;, &quot;&quot;))" />
</fragment>
