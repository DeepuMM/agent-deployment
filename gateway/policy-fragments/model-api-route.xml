<fragment>
  <!-- Shared by every project model API (models/<project>), inbound, after the project's routing table.
       Deployed by gateway-policy-deployment. Reads the context variables the routing table sets for the requested
       model (none set: the project may not use it):
         project          project name (token counter key)
         model            gateway model name (set by model-api-caller)
         model-status     value of named value ks-model-<model> (kill switch from the model platform deployment)
         model-tpm        the project's tokens per minute for this model (int)
         model-tpd        the project's tokens per day for this model (long)
         model-backend    APIM backend of the model's hosting Foundry account
         model-deployment deployment name in the hosting account -->

  <!-- Model not in the project's allowed list. -->
  <choose>
    <when condition="@(!context.Variables.ContainsKey(&quot;model-backend&quot;))">
      <return-response>
        <set-status code="404" reason="Not Found" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>@("{\"error\":{\"code\":\"MODEL_NOT_ALLOWED\",\"message\":\"Project " + context.Variables.GetValueOrDefault&lt;string&gt;("project", "") + " may not use model " + context.Variables.GetValueOrDefault&lt;string&gt;("model", "") + ".\"}}")</set-body>
      </return-response>
    </when>
  </choose>

  <!-- Kill switch: anything other than "active" blocks the model (fails closed). -->
  <choose>
    <when condition="@(!string.Equals(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;model-status&quot;, &quot;&quot;), &quot;active&quot;, StringComparison.OrdinalIgnoreCase))">
      <return-response>
        <set-status code="503" reason="Service Unavailable" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-header name="Retry-After" exists-action="override"><value>300</value></set-header>
        <set-body>@("{\"error\":{\"code\":\"AI_ROUTE_SUSPENDED\",\"message\":\"Model " + context.Variables.GetValueOrDefault&lt;string&gt;("model", "") + " is suspended by the platform kill switch.\"}}")</set-body>
      </return-response>
    </when>
  </choose>

  <!-- The project's token limit and daily quota for this model. -->
  <llm-token-limit counter-key="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;project&quot;, &quot;&quot;) + &quot;|&quot; + context.Variables.GetValueOrDefault&lt;string&gt;(&quot;model&quot;, &quot;&quot;))"
      tokens-per-minute="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;model-tpm&quot;, 0))"
      token-quota="@(context.Variables.GetValueOrDefault&lt;long&gt;(&quot;model-tpd&quot;, 0L))" token-quota-period="Daily"
      estimate-prompt-tokens="false" remaining-tokens-header-name="x-ratelimit-remaining-tokens" />

  <!-- The model's deployment in its hosting Foundry account. -->
  <set-backend-service backend-id="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;model-backend&quot;))" />
  <rewrite-uri template="@(&quot;/deployments/&quot; + context.Variables.GetValueOrDefault&lt;string&gt;(&quot;model-deployment&quot;) + &quot;/chat/completions&quot;)" copy-unmatched-params="true" />

  <!-- Replace the project's token with APIM's own identity for the hosting account. -->
  <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
</fragment>
