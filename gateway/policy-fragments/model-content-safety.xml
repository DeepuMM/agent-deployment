<fragment>
  <!-- Shared by every project model API (models/<project>), inbound, after model-api-route. Deployed by
       gateway-policy-deployment. Every prompt sent to a platform model (agent calls and evaluation judges) is checked
       by Azure AI Content Safety (backend "content-safety", APIM managed identity) before it reaches the model:
         - harm categories Hate, Sexual, SelfHarm, Violence, blocked at severity 4 or above (scale 0-7)
         - Prompt Shields (shield-prompt): blocks jailbreak and prompt-injection attempts
       Per project and model: the project's model API policy (in the requested model's routing-table branch) sets
       cs-hate, cs-sexual, cs-self-harm, cs-violence (int, 0-7) and cs-prompt-shields (bool) from project.yaml: the
       model's models.allowed[].content_safety, else the project's models.content_safety. A setting neither passes
       uses the platform default here: severity 4 for each category, Prompt Shields on. Settings can only be stricter
       (validated by agent-ci and the model-project-connection plan).
       A blocked prompt gets 403 and never reaches the model, so it uses no tokens. Runs after the kill switches and the
       allowed-model check, so suspended or refused calls cost no Content Safety call. The model deployment's own
       guardrail (model.yaml guardrail) still applies too, including to the model's answers. -->
  <llm-content-safety backend-id="content-safety" shield-prompt="@(context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;cs-prompt-shields&quot;, true))">
    <categories output-type="EightSeverityLevels">
      <category name="Hate" threshold="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;cs-hate&quot;, 4))" />
      <category name="Sexual" threshold="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;cs-sexual&quot;, 4))" />
      <category name="SelfHarm" threshold="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;cs-self-harm&quot;, 4))" />
      <category name="Violence" threshold="@(context.Variables.GetValueOrDefault&lt;int&gt;(&quot;cs-violence&quot;, 4))" />
    </categories>
  </llm-content-safety>
</fragment>
