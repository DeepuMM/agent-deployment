<!-- AI gateway policy for one project's model API (models/${project}), rendered by the model-project-connection stack.
     Only this project's values: its identity and its routing table (allowed models, their kill switch, token limits,
     backend). The logic is in shared policy fragments (gateway/policy-fragments/, deployed once per APIM by
     gateway-policy-deployment), so changing it needs no project re-run:
       model-api-caller  only this project's Foundry identity (token claim xms_mirid), correlation ID, model name
       model-api-route   MODEL_NOT_ALLOWED (404), kill switches (503), token limit, backend, APIM managed identity
       model-content-safety  Azure AI Content Safety on the prompt (403 if flagged)
       project-outbound  correlation ID on the response -->
<policies>
  <inbound>
    <base />
    <set-variable name="project" value="${project}" />
    <set-variable name="project-mirid" value="${project_mirid}" />
    <include-fragment fragment-id="model-api-caller" />
    <!-- Routing table: the allowed models. Any other model sets nothing, and model-api-route returns 404. -->
    <choose>
%{ for m in models ~}
      <when condition="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;model&quot;, &quot;&quot;) == &quot;${m.name}&quot;)">
        <set-variable name="model-status" value="{{${m.kill_switch}}}" />
        <set-variable name="model-tpm" value="@(${m.tokens_per_minute})" />
        <set-variable name="model-tpd" value="@(${m.tokens_per_day}L)" />
        <set-variable name="model-backend" value="${m.backend_id}" />
        <set-variable name="model-deployment" value="${m.deployment}" />
      </when>
%{ endfor ~}
    </choose>
    <include-fragment fragment-id="model-api-route" />
    <!-- Azure AI Content Safety on the prompt (harm categories, Prompt Shields): 403 if flagged. This project's
         settings (project.yaml models.content_safety); anything not set uses the platform default in the fragment. -->
%{ for v in content_safety ~}
    <set-variable name="${v.name}" value="@(${v.value})" />
%{ endfor ~}
    <include-fragment fragment-id="model-content-safety" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <include-fragment fragment-id="project-outbound" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
