<!-- AI gateway policy for one project-owned tool (tools/${project}/${tool}), rendered by tool-deploy (tool-deploy/terraform) from
     projects/${project}/tools/${tool}/tool.yaml. Only this tool's values; the logic is in shared policy fragments
     (ai-gateway repository, gateway/policy-fragments/, deployed once per APIM by gateway-policy-deployment):
       tool-caller  only the owner's Foundry project and those in shared_with (token claim xms_mirid); removes the
                    caller's token
       tool-route   kill switches (503), calls per minute per calling project, refuses MCP tools the owner didn't expose -->
<policies>
  <inbound>
    <base />
    <set-variable name="project" value="${project}" />
    <set-variable name="tool" value="${tool}" />
    <set-variable name="tool-callers" value="${callers}" />
    <set-variable name="tool-status" value="{{${kill_switch}}}" />
    <set-variable name="tool-names" value="${tool_names}" />
    <set-variable name="tool-rate" value="@(${rate})" />
    <include-fragment fragment-id="tool-caller" />
    <include-fragment fragment-id="tool-route" />
%{ if backend_leaf != "mcp" ~}
    <!-- The gateway endpoint is /mcp; the backend's MCP endpoint ends in /${backend_leaf}. -->
    <rewrite-uri template="/${backend_leaf}" copy-unmatched-params="true" />
%{ endif ~}
%{ if backend_auth == "managed_identity" ~}
    <!-- The tool's backend accepts APIM's managed identity; access is granted by the team that owns the tool. -->
    <authentication-managed-identity resource="${backend_audience}" />
%{ endif ~}
  </inbound>
  <backend>
    <!-- MCP streams (Server-Sent Events): pass each event on as it arrives. -->
    <forward-request buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
